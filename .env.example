# Copy to .env to enable optional integrations. Core engine runs without any of these.
# Climate (Open-Meteo): no key needed, used when geo present + temp/rainfall missing.
# LLM verbalizer (any OpenAI-compatible API): rephrases grounded output only. Off unless set.
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Dense retrieval upgrade (optional): RETRIEVER_BACKEND=dense + pip install sentence-transformers
RETRIEVER_BACKEND=bm25
